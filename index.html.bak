<script src="https://cdn.jsdelivr.net/npm/swiper@11.1.14/swiper-bundle.min.js"></script>
<script>
// ── Gallery Swiper (Point 4) ──────────────────────────────────
var galSwiper = new Swiper('.gallery', {
  slidesPerView: 1.4,
  centeredSlides: true,
  spaceBetween: 24,
  loop: true,
  speed: 700,
  autoplay: { delay: 3500, disableOnInteraction: false },
  navigation: { nextEl: '.gal-next', prevEl: '.gal-prev' },
  pagination: { el: '.gal-dots', clickable: true },
  breakpoints: {
    0:    { slidesPerView: 1.1, spaceBetween: 12 },
    1024: { slidesPerView: 1.4, spaceBetween: 24 }
  }
});

// ── Video reviews Swiper ──────────────────────────────────────
var rvSwiper = new Swiper('.rv-swiper', {
  slidesPerView: 'auto',
  spaceBetween: 16,
  navigation: { nextEl: '.rv-next', prevEl: '.rv-prev' }
});

// ── Text reviews Swiper ───────────────────────────────────────
var rtSwiper = new Swiper('.rt-swiper', {
  slidesPerView: 'auto',
  spaceBetween: 24,
  navigation: { nextEl: '.rt-next', prevEl: '.rt-prev' }
});

// ── Video Modal (Point 2: youtube-nocookie.com) ───────────────
var videoModal = document.getElementById('videoModal');
var videoFrame = document.getElementById('videoFrame');

function openVideo(src) {
  var url = src.replace('youtube.com', 'youtube-nocookie.com');
  videoFrame.innerHTML = '<iframe src="' + url + '" referrerpolicy="strict-origin-when-cross-origin" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>';
  videoModal.classList.add('is-active');
  document.body.style.overflow = 'hidden';
}
function closeVideo() {
  videoModal.classList.remove('is-active');
  videoFrame.innerHTML = '';
  document.body.style.overflow = '';
}
videoModal.querySelector('.modal-close').addEventListener('click', closeVideo);
videoModal.addEventListener('click', function(e) { if (e.target === videoModal) closeVideo(); });

// rv-card keyboard support
document.querySelectorAll('.rv-card').forEach(function(card) {
  card.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); card.click(); }
  });
});

// ── Text Review Modal ─────────────────────────────────────────
var textModal = document.getElementById('textModal');
var textModalBody = document.getElementById('textModalBody');

function openTextModal(text) {
  textModalBody.textContent = text;
  textModal.classList.add('is-active');
  document.body.style.overflow = 'hidden';
}
function closeTextModal() {
  textModal.classList.remove('is-active');
  document.body.style.overflow = '';
}
textModal.querySelector('.text-modal-close').addEventListener('click', closeTextModal);
textModal.addEventListener('click', function(e) { if (e.target === textModal) closeTextModal(); });

// ── Keyboard ──────────────────────────────────────────────────
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') { closeVideo(); closeTextModal(); }
});
</script>

</body>
</html>
